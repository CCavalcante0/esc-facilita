# Supabase — projeto "ESC FACILITA"
# Copie para .env.local e preencha. NUNCA commitar o .env.local (já ignorado).
# Preferir estes dois nomes: sem o prefixo NEXT_PUBLIC_, o valor é lido em
# runtime e passa a valer no próximo deploy, com ou sem cache de build.
# Todo acesso ao Supabase é no servidor, então nada aqui precisa ser público.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Aceitos por compatibilidade. ATENÇÃO: variáveis NEXT_PUBLIC_ são congeladas
# no bundle durante o build — configurá-las depois não tem efeito até refazer
# o build SEM cache.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) — necessária a partir do M1: o painel /admin usa
# supabase.auth.admin.createUser() para criar o login do cliente (operação
# que só a service role pode fazer). NUNCA expor no client.
SUPABASE_SECRET_KEY=
