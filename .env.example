# Supabase — projeto "ESC FACILITA"
# Copie para .env.local e preencha. NUNCA commitar o .env.local (já ignorado).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) — necessária a partir do M1: o painel /admin usa
# supabase.auth.admin.createUser() para criar o login do cliente (operação
# que só a service role pode fazer). NUNCA expor no client.
SUPABASE_SECRET_KEY=
